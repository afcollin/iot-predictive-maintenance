    {
      "type": "stat",
      "title": "MTTA: gns. tid til kvittering",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Mean time to acknowledge i den valgte periode: fra alarmen rejses, til en operatør kvitterer (AlarmAcknowledged)",
