# Kopiér filen til .env og tilpas værdierne. .env må aldrig committes (den står i .gitignore).
API_KEY=local-dev-key
POSTGRES_PASSWORD=iot-local-password
# Valgfri: send alarmer til en webhook, fx en Teams-, Slack- eller Discord-kanal eller https://webhook.site
NOTIFY_WEBHOOK_URL=
LOG_LEVEL=INFO
# Maks. kald pr. minut pr. klient på /api/v1 (0 = slået fra)
RATE_LIMIT_PER_MINUTE=120
# Observability-stakken (docker-compose.observability.yml). Skift portene, hvis 3000 eller 9090 er optaget
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=admin
